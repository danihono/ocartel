# Configuração do app Web do Firebase, usada no `next build` (produção).
#
# ESTE ARQUIVO É VERSIONADO, E ISSO É DE PROPÓSITO. Tudo que começa com NEXT_PUBLIC_ é
# embutido no bundle e chega ao navegador de qualquer visitante — não é segredo, e a
# segurança vem das regras do Firestore, não de esconder estas chaves. Os mesmos valores já
# estavam em texto puro no apphosting.yaml.
#
# O que isso resolve: o `firebase deploy` roda o build NA MÁQUINA de quem publica. Antes,
# quem não tivesse um `.env.local` preparado à mão via o build quebrar em
# "auth/invalid-api-key" ao pré-renderizar. Agora qualquer computador publica com um
# `git pull`.
#
# ┌─ O QUE NÃO PODE ENTRAR AQUI ─────────────────────────────────────────────────┐
# │ GEMINI_API_KEY, IA_SECRET, COBRANCAS_SECRET e qualquer outro segredo de       │
# │ servidor. Esses vivem no Secret Manager e são declarados em `firebase.json`   │
# │ (hosting.frameworksBackend.secrets). Colar um aqui é publicá-lo no GitHub.    │
# └──────────────────────────────────────────────────────────────────────────────┘
#
# Para desenvolvimento local com emulador, crie um `.env.local` — ele tem precedência
# sobre este arquivo e não é versionado.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD3kuQ1tQ7ZP0Rt1RDhicJWXzKetszTME8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ocartel-497f8.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ocartel-497f8
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ocartel-497f8.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=604756121837
NEXT_PUBLIC_FIREBASE_APP_ID=1:604756121837:web:467e5c00fef4a0ca7694e4

# Explícito, e não vazio: é este valor que impede o site publicado de tentar falar com
# 127.0.0.1 se alguém copiar o .env.example (que traz `true`) para o lugar errado.
NEXT_PUBLIC_USE_EMULATORS=false
