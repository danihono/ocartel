rules_version = '2';

// Modelo multi-tenant: cada usuário tem um doc users/{uid} com { role, tenantId }.
// O acesso a tenants/{t}/** é liberado quando o tenantId do usuário casa com {t}
// (ou quando o papel é superAdmin). As escritas de booking público NÃO passam por
// aqui — elas entram pela server action (Admin SDK), que ignora estas regras.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function uDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isSuper() {
      return signedIn() && uDoc().role == 'superAdmin';
    }
    function owns(tenantId) {
      return signedIn() && uDoc().tenantId == tenantId;
    }

    /**
     * Pertence à barbearia — a dona OU um barbeiro dela. É o nível de LEITURA do
     * operacional (agenda, clientes, serviços): o barbeiro precisa disso para a
     * própria tela funcionar.
     */
    function noTenant(tenantId) {
      return owns(tenantId) || isSuper();
    }

    /**
     * ADMINISTRA a barbearia: a dona (`admin`) ou o super admin. Um `barbeiro` NÃO
     * administra.
     *
     * Antes esta função era `owns() || isSuper()`, isto é, comparava só o tenant e
     * ignorava o papel — na prática um barbeiro tinha o mesmo poder da dona: escrevia
     * em clientes e transações, lia os fechamentos de comissão dos colegas e alcançava
     * `private/**`, onde mora a chave de API do gateway de cobrança. O papel agora pesa.
     */
    function canManage(tenantId) {
      return isSuper() || (owns(tenantId) && uDoc().role != 'barbeiro');
    }

    /** O barbeiro ao qual este usuário está vinculado ("" quando não é barbeiro). */
    function meuBarbeiroId() {
      return uDoc().get('barbeiroId', '');
    }

    // ---- Validações de shape/valor (escritas financeiras e de agenda) ----
    function statusAgendamentoValido(s) {
      return s in ['agendado', 'confirmado', 'atendimento', 'concluido', 'noshow', 'cancelado', 'bloqueio'];
    }
    function transacaoCreateValida() {
      let d = request.resource.data;
      return d.valor is number && d.valor >= 0
        && d.clienteNome is string
        && d.status in ['pago', 'pendente', 'atrasado'];
    }
    function transacaoUpdateValida() {
      let novo = request.resource.data;
      // `amount` (valor cobrado original) é imutável depois de criado.
      return (!('amount' in resource.data) || novo.amount == resource.data.amount)
        // Marcar como "pago" exige registro de recebimento (auditabilidade).
        && (novo.status != 'pago' || (novo.paidAt is string && novo.amountReceived is number))
        // `boleto` e `alertaEnviadoEm` são as travas de idempotência do ciclo automático:
        // é a AUSÊNCIA delas que autoriza emitir/enviar de novo. Quem as grava é o
        // servidor (Admin SDK, que não passa por estas regras); apagá-las ou reescrevê-las
        // pelo navegador faria o próximo ciclo cobrar a mesma pessoa outra vez.
        && (!('boleto' in resource.data) || novo.boleto == resource.data.boleto)
        && (!('alertaEnviadoEm' in resource.data) || novo.alertaEnviadoEm == resource.data.alertaEnviadoEm)
        // `cartaoCobranca` é a mesma trava, para o cartão. Aqui apagá-la pelo navegador
        // não faria o cliente receber um segundo boleto: faria o próximo ciclo DEBITAR o
        // cartão dele outra vez.
        && (!('cartaoCobranca' in resource.data) || novo.cartaoCobranca == resource.data.cartaoCobranca);
    }

    // Fechamento de comissão: o valor apurado e o retrato da regra usada são IMUTÁVEIS
    // depois de gravados. Não é preciosismo — é o que impede que mudar o percentual hoje
    // reescreva quanto se combinou de pagar em maio. Mesma disciplina de `amount` nas
    // transações. O que continua editável é só o registro de que a comissão foi paga.
    function fechamentoUpdateValido() {
      let novo = request.resource.data;
      let velho = resource.data;
      return novo.total == velho.total
        && novo.regra == velho.regra
        && novo.mes == velho.mes
        && novo.barbeiroId == velho.barbeiroId
        && novo.fechadoEm == velho.fechadoEm;
    }

    // O espelho das conversas de WhatsApp vive em users/barbearia-{tenantId}/contacts/**,
    // escrito pelo daemon (Baileys) com o Admin SDK. "barbearia-{t}" NÃO é um usuário do
    // Firebase Auth: é só a chave de caminho que o daemon usa por sessão.
    //
    // A tela de WhatsApp lê isso AO VIVO, direto do navegador — se dependesse de polling
    // por server action, a resposta do cliente só apareceria no próximo tique. Escrever
    // continua sendo exclusividade do servidor: aqui só há `read`.
    //
    // isSuper() vem primeiro porque um superAdmin não tem tenantId no perfil.
    function podeVerEspelho(uid) {
      return isSuper() || (signedIn() && uid == 'barbearia-' + uDoc().tenantId);
    }

    // Perfil do usuário. Auto-cadastro só pode criar a si mesmo como 'admin'.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuper());
      allow create: if request.auth.uid == uid
        && request.resource.data.role == 'admin'
        && request.resource.data.keys().hasAll(['role', 'tenantId', 'nome', 'email']);
      allow update: if isSuper()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.tenantId == resource.data.tenantId);
      allow delete: if isSuper();

      match /contacts/{contactId} {
        allow read: if podeVerEspelho(uid);
        match /messages/{msgId} {
          allow read: if podeVerEspelho(uid);
        }
      }
    }

    // Reserva de slug público (slug -> tenantId) para a página /book/[slug].
    match /slugs/{slug} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isSuper();
    }

    match /tenants/{tenantId} {
      // Doc público (nome, slug, endereco, plano) — NÃO guardar segredos aqui.
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if canManage(tenantId);

      // Dados sensíveis (billing, vínculo do WhatsApp, chave do gateway de cobrança)
      // ficam isolados e nunca são públicos. NÃO mover nada disto para `config/`, que é
      // `allow read: if true` para alimentar a vitrine de /book/[slug].
      match /private/{doc} {
        allow read, write: if canManage(tenantId);
      }

      // Cartões salvos — VITRINE: bandeira e quatro últimos dígitos, nada mais. O token
      // NÃO está aqui; ele mora em `private/cartoes/clientes/{id}`, que não casa com
      // `match /private/{doc}` (um segmento só) e portanto cai no deny padrão — nem o
      // dono da barbearia o alcança pelo navegador, que é o nível certo para um
      // instrumento de débito. Só leitura, mesma razão de `sugestoes`: quem escreve é o
      // servidor, e é de propósito.
      match /cartoes/{id} { allow read: if canManage(tenantId); }

      // Catálogo de leitura pública (a vitrine de /book/[slug]).
      match /servicos/{id}    { allow read: if true; allow write: if canManage(tenantId); }
      match /barbeiros/{id}   { allow read: if true; allow write: if canManage(tenantId); }
      match /config/{id}      { allow read: if true; allow write: if canManage(tenantId); }
      match /planosTiers/{id} { allow read: if true; allow write: if canManage(tenantId); }

      // Dados privados do tenant.
      match /clientes/{id} {
        // O barbeiro LÊ a ficha de quem ele atende; quem cadastra e edita é a dona.
        allow read: if noTenant(tenantId);
        allow delete: if canManage(tenantId);
        allow create, update: if canManage(tenantId) && request.resource.data.nome is string;
      }
      match /transacoes/{id} {
        // Leitura liberada ao barbeiro porque a tela dele fecha o atendimento e mostra o
        // resumo do dia. Dinheiro só é LANÇADO por quem administra.
        allow read: if noTenant(tenantId);
        allow delete: if canManage(tenantId);
        allow create: if noTenant(tenantId) && transacaoCreateValida();
        allow update: if canManage(tenantId) && transacaoUpdateValida();
      }
      match /agendamentos/{id} {
        allow read: if noTenant(tenantId);
        allow delete: if canManage(tenantId);
        allow create, update: if noTenant(tenantId)
          && statusAgendamentoValido(request.resource.data.status)
          && request.resource.data.duracaoMin is number
          // O barbeiro mexe só na PRÓPRIA coluna: marca, conclui e bloqueia o horário
          // dele. A agenda dos colegas é leitura.
          && (canManage(tenantId) || request.resource.data.barbeiroId == meuBarbeiroId());
      }
      // Agendamentos PROPOSTOS pelo atendente automático, e o estado de cada conversa
      // (pausa da IA, contadores). Só leitura: quem escreve é o servidor, e é de propósito
      // — se o navegador pudesse gravar sugestão, o card "confirmar" viraria um jeito de
      // criar agendamento pulando `criarAgendamentoValidado`.
      match /sugestoes/{id} { allow read: if canManage(tenantId); }
      match /conversas/{id} { allow read: if canManage(tenantId); }

      // Planos de assinatura do cliente (mensalidade) — privados do tenant.
      match /planos/{id} {
        allow read: if noTenant(tenantId);
        allow delete: if canManage(tenantId);
        allow create, update: if canManage(tenantId) && request.resource.data.valor is number;
      }

      // Fechamentos mensais de comissão. Privados: quanto cada barbeiro recebe não é
      // dado de vitrine. `delete` é a reabertura do mês, feita de propósito na tela.
      match /fechamentos/{id} {
        allow read, delete: if canManage(tenantId);
        allow create: if canManage(tenantId)
          && request.resource.data.total is number
          && request.resource.data.mes is string
          && request.resource.data.barbeiroId is string;
        allow update: if canManage(tenantId) && fechamentoUpdateValido();
      }

    }
  }
}
