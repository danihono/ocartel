# Copie para .env.local e preencha com as chaves do app Web do seu projeto Firebase.
# (Firebase Console → Configurações do projeto → Seus apps → Web → SDK setup)
# Tudo que começa com NEXT_PUBLIC_ é embutido no bundle do cliente (não é segredo
# para o Firebase Web — a segurança vem das regras do Firestore).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ocartel-497f8.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ocartel-497f8
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ocartel-497f8.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=604756121837
NEXT_PUBLIC_FIREBASE_APP_ID=

# Liga os emuladores locais (auth/firestore) durante o desenvolvimento.
# Use "true" ao rodar `npm run emulators`. Em produção deixe vazio/false.
NEXT_PUBLIC_USE_EMULATORS=true

# Faz o Admin SDK (server action do booking) apontar para o emulador do Firestore
# em desenvolvimento. Deixe comentado/vazio em produção (usa ADC do App Hosting).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Apenas para rodar scripts/provision-super-admin.ts localmente ---
# Caminho para o JSON da service account (Firebase Console → Contas de serviço →
# Gerar nova chave privada). NUNCA versione esse arquivo. Em produção o App
# Hosting usa as credenciais padrão do ambiente (ADC) e isto não é necessário.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# --- Disparos agendados (rotas batidas por um timer externo, de hora em hora) ---
# Segredo compartilhado das confirmações do dia (POST /api/confirmacoes/disparar,
# header x-confirmacoes-secret). A rota devolve 401 sem ele e 500 se a variável faltar.
CONFIRMACOES_SECRET=

# Segredo do ciclo de cobrança: gera as mensalidades do mês, avisa os assinantes antes do
# vencimento e emite boleto de quem não pagou (POST /api/cobrancas/ciclo, header
# x-cobrancas-secret). Ver docs/cobranca-automatica.md.
#
# ATENÇÃO: em produção isto NÃO vem daqui. O site vai ao ar pelo Firebase Hosting com
# `frameworksBackend` (ver README, "Publicar"), então o SSR roda numa Cloud Function e o
# segredo precisa estar no Secret Manager, declarado em `firebase.json`. Este valor aqui
# serve só para rodar a rota localmente.
COBRANCAS_SECRET=

# A chave do Asaas NÃO fica aqui: é por barbearia, em tenants/{id}/private/asaas, e se
# cadastra pela tela de Configurações. Cada barbearia recebe na própria conta.

# --- Atendente automático (Gemini) ---
#
# ATENÇÃO: em produção estes NÃO vêm daqui — mesma história do COBRANCAS_SECRET acima. O
# SSR roda numa Cloud Function, e ela só enxerga o segredo se ele estiver no Secret Manager
# E declarado em `firebase.json` (hosting.frameworksBackend.secrets, já declarados lá):
#
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set IA_SECRET
#
# Segredo listado em firebase.json que ainda não existe no Secret Manager faz o
# `firebase deploy --only hosting` FALHAR — crie os dois antes de publicar.
#
# Os valores abaixo servem só para rodar a rota localmente.

# Chave do Google AI Studio (aistudio.google.com/apikey).
GEMINI_API_KEY=

# Senha compartilhada entre o site e a Cloud Function que dispara o atendimento
# (POST /api/ia/responder, header x-ia-secret). Ninguém digita: invente algo longo.
# A Function lê o MESMO segredo, por `defineSecret` — os dois valores têm que bater.
IA_SECRET=

# Modelo usado. Vazio = gemini-2.5-flash (o padrão em lib/ia/gemini.ts). Existe para trocar
# de modelo sem mexer em código; em produção, mudar aqui exige rebuild.
GEMINI_MODEL=
