{
  "name": "o-cartel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "firebase deploy --only hosting,firestore:rules,storage",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "emulators": "firebase emulators:start --import=./.seed --export-on-exit",
    "emulators:export": "firebase emulators:export ./.seed",
    "provision:super-admin": "tsx scripts/provision-super-admin.ts",
    "whatsapp:parear": "tsx scripts/whatsapp-parear.ts",
    "limpar:tenants": "tsx scripts/limpar-tenants.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project ocartel-497f8 \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "^11.3.0",
    "firebase-admin": "^13.0.2",
    "next": "15.1.12",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.12",
    "firebase-tools": "^13.29.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
